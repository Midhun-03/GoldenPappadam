{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/GoldenPappadam.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5207
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "client"
      ],
      "port": 5173
    },
    {
      "name": "api-lan",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/GoldenPappadam.Api",
        "--launch-profile",
        "lan"
      ],
      "port": 5207
    }
  ]
}
